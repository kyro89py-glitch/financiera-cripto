# Copia este archivo como .env y completa los valores. No subas el .env a ningún repositorio.

# Dominio público, por ejemplo app.tuempresa.com.py (lo usa Caddy para el certificado HTTPS)
DOMINIO=

# Clave larga y aleatoria. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FINANCIERA_ENTORNO=produccion
FINANCIERA_NOMBRE=Financiera Cripto
ZONA_HORARIA=America/Asuncion

# Seguridad
EXIGIR_2FA_EQUIPO=1
INACTIVIDAD_MIN=30
INTENTOS_LOGIN=5
BLOQUEO_MIN=15

# Reglas de negocio (en dólares)
APORTE_MINIMO_USD=100
UMBRAL_ORIGEN_FONDOS_USD=10000
UMBRAL_DOBLE_FIRMA_USD=25000
PRECIO_MAX_MINUTOS=60

# Comisión de gestión anual en porcentaje (se cobra la doceava parte cada mes; 0 la desactiva)
COMISION_ANUAL_PCT=1.5

# Legajo: tamaño máximo de cada documento en MB
DOCUMENTO_MAX_MB=8

# Envíos entre clientes: límite diario por cliente y monto desde el que se avisa a Cumplimiento (USD)
ENVIO_MAX_DIA_USD=5000
ENVIO_AVISO_USD=2000

# Máximo en dólares de cada compra o venta que el cliente hace por su cuenta
ORDEN_MAXIMA_USD=25000

# Ejecución de órdenes: simulado (por defecto) o binance
EJECUCION=simulado
# Clave de API de Binance: solo permiso de Spot, SIN retiros y restringida a la IP del servidor
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Red de pruebas por defecto. Para operar con dinero real: https://api.binance.com
BINANCE_URL=https://testnet.binance.vision
# Fuente de precios: binance, coingecko o simulada (solo demostración). Por defecto, binance si EJECUCION=binance
FUENTE_PRECIOS=
# Segundos entre actualizaciones de precios en vivo (servicio «precios»)
VIVO_SEGUNDOS=3
# Comisión por orden que cobra Binance, para mostrarla antes de confirmar (%)
COMISION_EXCHANGE_PCT=0.1

# Métodos de depósito y retiro opcionales (vacío = no se ofrecen)
OFICINA_DIRECCION=
DEPOSITO_USDT_DIRECCION=
DEPOSITO_USDT_RED=TRON (TRC-20)

# Precios: clave gratuita de CoinGecko (opcional, mejora el límite de consultas)
COINGECKO_API_KEY=

# Texto que ve el cliente al aportar
INSTRUCCIONES_DEPOSITO=Transfiere el monto a la cuenta de la empresa en el Banco X (cuenta 000-000000, RUC 80000000-0) y escribe el número de comprobante.

# Dirección pública del sistema (enlaces de los correos y pie de los estados de cuenta)
URL_PUBLICA=https://app.tuempresa.com.py

# Correo para los avisos (opcional; sin SMTP_HOST los avisos solo se ven en el portal)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=Financiera Cripto <avisos@tuempresa.com.py>
