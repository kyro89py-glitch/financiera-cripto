# Copia este archivo como .env y completa los valores. No subas el .env a ningún repositorio.

# Dominio público, por ejemplo app.tuempresa.com.py (lo usa Caddy para el certificado HTTPS)
DOMINIO=

# Clave larga y aleatoria. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FINANCIERA_ENTORNO=produccion
FINANCIERA_NOMBRE=Financiera Cripto
ZONA_HORARIA=America/Asuncion

# Seguridad
EXIGIR_2FA_EQUIPO=1
INACTIVIDAD_MIN=30
INTENTOS_LOGIN=5
BLOQUEO_MIN=15

# Reglas de negocio (en dólares)
APORTE_MINIMO_USD=100
UMBRAL_ORIGEN_FONDOS_USD=10000
UMBRAL_DOBLE_FIRMA_USD=25000
PRECIO_MAX_MINUTOS=60

# Precios: clave gratuita de CoinGecko (opcional, mejora el límite de consultas)
COINGECKO_API_KEY=

# Texto que ve el cliente al aportar
INSTRUCCIONES_DEPOSITO=Transfiere el monto a la cuenta de la empresa en el Banco X (cuenta 000-000000, RUC 80000000-0) y escribe el número de comprobante.
